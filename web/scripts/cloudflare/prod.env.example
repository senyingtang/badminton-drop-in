# 正式 Worker 建置值（只放公開的 NEXT_PUBLIC_*）。複製到 repo 外：D:\project\secrets\prod.env
# 值與 Vercel 正式站 Production 環境變數相同（Vercel → Project → Settings → Environment Variables）。
# service_role 不放這裡：存成 D:\project\secrets\prod-service-role.txt，由 cf-deploy-prod.ps1 -SetServiceRoleFile 設成 Worker secret。
NEXT_PUBLIC_SUPABASE_URL=https://ngudidpitcfyzmbphlgt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<正式 anon key（與 web/.env.production 相同）>
NEXT_PUBLIC_LINE_LIFF_ID=<正式 LIFF ID，例如 1234567890-AbCdEfGh>
# 選填：Vercel 有設定才填
# NEXT_PUBLIC_LINE_LIFF_URL=https://liff.line.me/<LIFF ID>
