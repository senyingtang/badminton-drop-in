# Demo Preview build variables (NOT secrets). Used with:
#   ./scripts/cloudflare/cf-deploy-preview.ps1 -IgnoreEnvToken -EnvFile .\scripts\cloudflare\demo-preview.env
# The Supabase URL is a reserved .invalid host: every Supabase call is answered by the in-app
# read-only fake backend (src/lib/demo/demoFetch.ts). No real Supabase, LINE or ECPay is reachable.
NEXT_PUBLIC_DEMO_PREVIEW=1
NEXT_PUBLIC_SUPABASE_URL=https://demo-preview.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=demo-preview-anon-key-not-a-secret
NEXT_PUBLIC_LINE_LIFF_ID=
NEXT_PUBLIC_LINE_LIFF_URL=
