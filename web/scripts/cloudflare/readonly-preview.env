# Read-only integration preview (NOT secrets). Used with:
#   ./scripts/cloudflare/cf-deploy-preview.ps1 -Target readonly -IgnoreEnvToken -EnvFile .\scripts\cloudflare\readonly-preview.env
# Supabase URL / anon key come from web/.env.production (public values, production project).
# The Worker gate (src/worker/entry.ts) blocks every write; PREVIEW_ACCESS_PASSWORD (Worker secret) is required;
# SUPABASE_SERVICE_ROLE_KEY must never be bound to this Worker.
NEXT_PUBLIC_READONLY_PREVIEW=1
